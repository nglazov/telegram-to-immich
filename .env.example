# Copy to .env. It is private (chmod 600) and excluded from Git.
APP_PASSWORD=
APP_ORIGIN=http://localhost:8213

# Get your own values at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: leave empty to work entirely without Immich.
IMMICH_URL=
IMMICH_API_KEY=
# Optional browser address when IMMICH_URL uses an internal Docker hostname.
IMMICH_PUBLIC_URL=

# Initial mode only. Real downloads require an explicit mode selection and start.
DRY_RUN=true

# Docker Compose only. Match the owner of the bind-mounted directories.
# APP_UID=1028
# APP_GID=1028
# BIND_ADDRESS=127.0.0.1
# APP_PORT=8213
# STATE_PATH=./state
# PHOTOS_PATH=./photos

# Use Telegram Takeout for media downloads; dry run uses normal API.
TELEGRAM_TAKEOUT=true

# Pause between file downloads (seconds, 0–300). Telegram FloodWait always takes precedence.
TELEGRAM_DOWNLOAD_DELAY_SECONDS=3
